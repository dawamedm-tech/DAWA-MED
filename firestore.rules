rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (request.auth.token.role == role || getUserData().role == role);
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'super_admin' || 
        request.auth.token.role == 'medical_admin' || 
        request.auth.token.role == 'operations_admin' || 
        getUserData().role == 'admin' || 
        getUserData().role == 'super_admin' ||
        getUserData().role == 'medical_admin' || 
        getUserData().role == 'operations_admin'
      );
    }
    
    function isSupport() {
      return isAuthenticated() && (hasRole('support') || isAdmin());
    }
    
    function isPharmacy() {
      return isAuthenticated() && (hasRole('pharmacy') || isAdmin());
    }
    
    function isDriver() {
      return isAuthenticated() && (hasRole('driver') || isAdmin());
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isSupport());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // FAMILY HEALTH PROFILES
    match /family_profiles/{profileId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // CHRONIC PRESCRIPTION REFILLS
    match /chronic_refills/{refillId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || isPharmacy());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || isPharmacy());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // AI PRESCRIPTION OCR RECORDS
    match /prescription_ai_ocr/{ocrId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isPharmacy() || isAdmin());
      allow delete: if isAdmin();
    }

    // PHARMACIES COLLECTION
    match /pharmacies/{pharmacyId} {
      allow read: if true; // Directory visible to patients
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isPharmacy() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // MEDICINES CATALOG COLLECTION (Regulatory Enforcement)
    match /medicines/{medicineId} {
      allow read: if resource.data.approvalStatus == 'approved' || isPharmacy() || isAdmin() || isSupport();
      allow create: if isPharmacy() || isAdmin();
      allow update: if isAdmin() || (isPharmacy() && resource.data.submittedByPharmacyId == request.auth.uid && resource.data.approvalStatus != 'approved');
      allow delete: if isAdmin();
    }

    // PRESCRIPTIONS (Confidential Medical Records)
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        (isPharmacy() && resource.data.assignedPharmacyId == getUserData().pharmacyId) || 
        isAdmin() || 
        isSupport()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        (isPharmacy() && resource.data.assignedPharmacyId == getUserData().pharmacyId) || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ORDERS COLLECTION
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        (isPharmacy() && resource.data.pharmacyId == getUserData().pharmacyId) || 
        (isDriver() && resource.data.assignedDriverId == request.auth.uid) || 
        isAdmin() || 
        isSupport()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        (isPharmacy() && resource.data.pharmacyId == getUserData().pharmacyId) || 
        (isDriver() && resource.data.assignedDriverId == request.auth.uid) || 
        isAdmin() || 
        isSupport()
      );
      allow delete: if isAdmin();
    }

    // PAYMENTS & FINANCIAL SETTLEMENTS (Immutable)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // AUDIT LOGS (Cryptographic Tamper-Evident Trail)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // SUPPORT TICKETS
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        isSupport() || 
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isSupport() || isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // TELEMETRY & COLD CHAIN SENSOR LOGS
    match /telemetry/{telemetryId} {
      allow read: if isAuthenticated();
      allow create: if isDriver() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // SYSTEM HEALTH & STATUS CHECKS
    match /system_health/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SETTINGS & MONETIZATION
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AUTH SESSIONS (Production Session Store with SHA-256 Token Hashes)
    match /auth_sessions/{tokenHash} {
      allow read, write: if true;
    }

    // DEFAULT CATCH-ALL
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
