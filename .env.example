# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Pan-African Payment Gateways (Live / Sandbox)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MTN_MOMO_PRIMARY_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# SMS & OTP Provider (Africa's Talking / Twilio)
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME=""
AFRICAS_TALKING_SENDER_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Cloud Storage & Security
GCS_BUCKET_NAME="dawa-med-prescriptions-secure"
JWT_SECRET="dawa-med-production-super-secret-key-2026"
IOT_TELEMETRY_WEBHOOK_SECRET="dawa-iot-telemetry-key-2026"
ADMIN_INITIAL_PASSWORD=""

# Email Provider Configuration (Resend & SMTP)
EMAIL_PROVIDER="resend" # "resend" | "smtp"
RESEND_API_KEY=""
EMAIL_SENDER_NAME="DAWA MED"
EMAIL_SENDER_ADDRESS="no-reply@dawamed.com"
EMAIL_REPLY_TO="support@dawamed.com"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_SECURE="false" # "true" for port 465, "false" for 587
SMTP_USER=""
SMTP_PASS=""

