# ====================================================================
# DAWA MED — ENVIRONMENT VARIABLES MANIFEST
# ====================================================================
# Note: In Google AI Studio, variables marked as injected by the platform
# (e.g. GEMINI_API_KEY, APP_URL) are automatically supplied at runtime.
# Do NOT commit actual secrets or sensitive credentials to this file.

# --------------------------------------------------------------------
# A. REQUIRED TO START THE APPLICATION
# --------------------------------------------------------------------
# None. The server initializes with built-in production defaults,
# ephemeral in-memory state fallback, and automatically reads
# pre-provisioned Firebase credentials from firebase-applet-config.json.

# --------------------------------------------------------------------
# B. CORE AUTHENTICATION & SECURITY (Backend)
# --------------------------------------------------------------------
# Primary secret for cryptographic token signing and session integrity
# [SECRET — MUST BE GENERATED SECURELY]
JWT_SECRET=

# Secret for generating anti-counterfeit medicine QR verification codes
# [SECRET — MUST BE GENERATED SECURELY] (Falls back to JWT_SECRET if unset)
QR_HMAC_SECRET=

# Initial one-time setup password for primary Super Administrator
# [SECRET — MUST BE GENERATED SECURELY] (Super admin must change upon first login)
ADMIN_INITIAL_PASSWORD=

# Webhook authentication secret for IoT cold-chain temperature telemetry
# [SECRET — MUST BE GENERATED SECURELY]
IOT_TELEMETRY_WEBHOOK_SECRET=

# --------------------------------------------------------------------
# C. GOOGLE LOGIN & FIREBASE (Frontend & Backend)
# --------------------------------------------------------------------
# In Google AI Studio, Firebase is already configured via firebase-applet-config.json.
# The following optional variables allow overriding for external Firebase projects:
# (Client-side / Public)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Server-Side Firebase Admin Service Account Key JSON (for production verifyIdToken & Admin SDK)
# [SECRET — MUST BE GENERATED SECURELY]
FIREBASE_SERVICE_ACCOUNT_KEY=

# --------------------------------------------------------------------
# D. PAYMENT GATEWAYS (Backend — Optional at startup)
# --------------------------------------------------------------------
# Safaricom Daraja M-Pesa (Kenya)
# [SECRET — MUST BE GENERATED SECURELY]
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=
MPESA_CALLBACK_URL=

# Paystack (Nigeria, Ghana, South Africa, Kenya)
# [SECRET — MUST BE GENERATED SECURELY]
PAYSTACK_SECRET_KEY=
# Public key can be shared with frontend if needed
PAYSTACK_PUBLIC_KEY=

# Flutterwave (Pan-African)
# [SECRET — MUST BE GENERATED SECURELY]
FLUTTERWAVE_SECRET_KEY=

# MTN Mobile Money (Uganda, Rwanda, Ghana, Cameroon)
# [SECRET — MUST BE GENERATED SECURELY]
MTN_MOMO_PRIMARY_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# --------------------------------------------------------------------
# E. SMS & OTP NOTIFICATIONS (Backend — Optional at startup)
# --------------------------------------------------------------------
# Africa's Talking
# [SECRET — MUST BE GENERATED SECURELY]
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=

# Twilio (Global SMS Fallback)
# [SECRET — MUST BE GENERATED SECURELY]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --------------------------------------------------------------------
# F. TRANSACTIONAL EMAIL (Backend — Optional at startup)
# --------------------------------------------------------------------
EMAIL_PROVIDER=
# [SECRET — MUST BE GENERATED SECURELY]
RESEND_API_KEY=
EMAIL_SENDER_NAME=
EMAIL_SENDER_ADDRESS=
EMAIL_REPLY_TO=

# SMTP Server Alternative
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
# [SECRET — MUST BE GENERATED SECURELY]
SMTP_PASS=

# --------------------------------------------------------------------
# G. AI & CLOUD STORAGE SERVICES (Optional at startup)
# --------------------------------------------------------------------
# Google Gemini API key for clinical prescription multimodal OCR
# [SECRET — Automatically provided by AI Studio if available]
GEMINI_API_KEY=

# Production App URL (e.g. https://dawamed.shop)
APP_URL=
API_URL=

# Google Cloud Storage Bucket for Prescriptions
GCS_BUCKET_NAME=
